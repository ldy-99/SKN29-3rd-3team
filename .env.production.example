# Shared Python services
OPENAI_API_KEY=replace-with-production-openai-api-key

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false

# Use the production domain or server IP that users will access.
DJANGO_ALLOWED_HOSTS=your-domain.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://your-domain.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example.com

# Django -> FastAPI internal Docker service URL
FASTAPI_API_URL=http://fastapi-backend:8080
FASTAPI_PROFILE_TIMEOUT=10
FASTAPI_SIMULATE_TIMEOUT=30
FASTAPI_CHATBOT_TIMEOUT=30
FASTAPI_ANNOUNCEMENT_TIMEOUT=90
FASTAPI_PDF_TIMEOUT=90

# Production cookies should be sent only over HTTPS.
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
