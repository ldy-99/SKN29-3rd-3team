# Shared Python services
OPENAI_API_KEY=replace-with-production-openai-api-key

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false

# Current final deployment uses HTTP on a-fit.duckdns.org.
DJANGO_ALLOWED_HOSTS=a-fit.duckdns.org,43.201.113.124
DJANGO_CORS_ALLOWED_ORIGINS=http://a-fit.duckdns.org
DJANGO_CSRF_TRUSTED_ORIGINS=http://a-fit.duckdns.org

# Django -> FastAPI internal Docker service URL
FASTAPI_API_URL=http://fastapi-backend:8080
FASTAPI_PROFILE_TIMEOUT=10
FASTAPI_SIMULATE_TIMEOUT=30
FASTAPI_CHATBOT_TIMEOUT=30
FASTAPI_ANNOUNCEMENT_TIMEOUT=90
FASTAPI_PDF_TIMEOUT=90

# HTTP deployment keeps secure-cookie flags disabled.
# Change both to true when HTTPS is applied.
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
